# Copy this file to keystore.properties (git-ignored) to get a signed release build.
# storeFile is resolved relative to the companion/ directory.
#
# Create the keystore once and keep it forever: Headwind (and Android itself) will only
# update an installed app with an APK signed by the same key.
#
#   keytool -genkeypair -v -keystore signing/companion.keystore -alias companion \
#       -keyalg RSA -keysize 2048 -validity 10000
storeFile=signing/companion.keystore
storePassword=change-me
keyAlias=companion
keyPassword=change-me
