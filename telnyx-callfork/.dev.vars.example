# Copy to .dev.vars for local `wrangler dev`. .dev.vars is gitignored — keep it
# that way. This repo is public; real numbers committed here would be permanent.
#
# In production these are set with `npx wrangler secret put <NAME>`, not here.

TELNYX_US_DID="+15550001111"
SIP_URI="sip:yourcredential@sip.telnyx.com"
FLIP_NUMBER="+972500000000"
IPHONE_HOT_NUMBER="+972500000001"

# Optional: enables webhook signature verification locally.
# TELNYX_PUBLIC_KEY="base64-ed25519-public-key"
